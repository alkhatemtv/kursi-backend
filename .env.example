# ─────────────────────────────────────────────────────────────
# Kursi.io Backend — Environment Configuration
# Copy this file to `.env` and fill in your real values.
# Never commit `.env` to git!
#
# This file lists EVERY environment variable the application reads.
# Names only — never put a real secret in here.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Read by: app/config.py, app/database.py, alembic/env.py, scripts/migrate.py
# SQLite for local dev (file is created automatically).
# For production switch to PostgreSQL: postgresql://user:pass@host:5432/dbname
# On Railway this is a reference variable pointing at the Postgres service —
# leave that wiring exactly as it is.
DATABASE_URL=sqlite:///./kursi.db

# ── Auth0 ───────────────────────────────────────────────────
# Get these from your Auth0 dashboard:
#   1. Go to https://manage.auth0.com → Applications → APIs
#   2. Create an API named "Kursi API" with identifier https://api.kursi.io
#   3. Copy the values below from your tenant settings
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_API_AUDIENCE=https://api.kursi.io
AUTH0_ALGORITHMS=RS256
# Custom claim namespace used to read user role/email from the token
# (set up via an Auth0 Action / Rule — see README)
AUTH0_NAMESPACE=https://kursi.io/

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the API.
# Add your production domain when you deploy. The GitHub Pages origin must be
# included so the live frontend at alkhatemtv.github.io can reach the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500,https://kursi.io,https://alkhatemtv.github.io

# ── Anthropic (AI Layout Generator) ─────────────────────────
# Required for /api/ai/* endpoints. If absent, those endpoints return 503
# but the rest of the API is unaffected. Never commit a real key.
ANTHROPIC_API_KEY=

# ── Environment labelling ───────────────────────────────────
# ENV is the canonical name: production | staging | development.
# It is surfaced by GET /health. Nothing branches on it yet — it is a label.
# APP_ENV is the older name and is still honoured as a fallback, so existing
# deployments that only set APP_ENV keep working. Prefer ENV for new setups.
ENV=development
APP_ENV=development

# ── Build identity (optional) ───────────────────────────────
# Reported as `version` by GET /health. Railway injects RAILWAY_GIT_COMMIT_SHA
# automatically on every deploy, so you normally do NOT need to set anything.
# If the platform provides none of these, /health falls back to `git rev-parse`
# and finally to "unknown".
# GIT_COMMIT=
# RAILWAY_GIT_COMMIT_SHA=
# SOURCE_VERSION=

# ── Server (set by the platform) ────────────────────────────
# Railway injects PORT; scripts/start.sh passes it to uvicorn.
# PORT=8000

# ── Testing only ────────────────────────────────────────────
# Read by tests/conftest.py, never by the app itself.
# Leave UNSET to use a throwaway SQLite file (the default and the safe choice).
# Set it only to run the suite against a real Postgres for dialect fidelity —
# it must point at a scratch database. conftest.py refuses any URL that looks
# like a live/Railway host. See TESTING.md.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kursi_test
